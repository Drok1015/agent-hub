{
  "name": "agent-hub",
  "version": "1.0.0",
  "description": "Agent Hub - 中心化 Agent 协作平台",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "agent",
    "collaboration",
    "websocket",
    "realtime"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.30.0",
    "fastify": "^5.0.0",
    "jose": "^5.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.0.0",
    "drizzle-kit": "^0.21.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
